{
    "compilerOptions": {
      "target": "ESNext",
      "useDefineForClassFields": true,
      "module": "ESNext",
      "moduleResolution": "bundler",
      "strict": true,
      "jsx": "preserve",
      "isolatedModules": true,
      "allowJs": true,
      "checkJs": false,
      "esModuleInterop": true,
      "allowSyntheticDefaultImports": true,
      "resolveJsonModule": true,
      "sourceMap": true,
      "paths": {
        "@/*": ["./src/*"],
        "vue3-recaptcha2": ["./node_modules/vue3-recaptcha2/dist_types/index.d.ts"]
      },
      "types": ["node", "vite/client"],
      "noEmit": true,
      "skipLibCheck": true
    },
    "include": [
      "src/**/*.ts",
      "src/**/*.d.ts",
      "src/**/*.vue"
    ],
    "exclude": ["node_modules", "dist"]
}
  