{
  "name": "clientapp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build",
    "staging": "vue-tsc --noEmit -p tsconfig.json && vite build --mode staging",
    "production": "vue-tsc --noEmit -p tsconfig.json && vite build --mode production",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,vue,js,json,css,scss}\""
  },
  "dependencies": {
    "@vee-validate/rules": "^4.15.1",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vueup/vue-quill": "^1.2.0",
    "axios": "^1.10.0",
    "buefy": "^3.0.10",
    "core-js": "^3.49.0",
    "d3-array": "^3.2.4",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "dayjs": "^1.11.13",
    "google-libphonenumber": "^3.2.38",
    "image-compressor.js": "^1.1.4",
    "oidc-client-ts": "^3.5.0",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "popper.js": "^1.16.1",
    "qs": "^6.11.1",
    "sass": "^1.89.2",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.32",
    "vue-cropperjs": "^5.0.0",
    "vue-lazyload": "^3.0.0",
    "vue-router": "^4.6.4",
    "vue-scrollto": "^2.20.0",
    "vue3-recaptcha2": "^1.8.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/d3-array": "^3.2.2",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.8",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@vue/eslint-config-prettier": "^10.2.0",
    "autoprefixer": "^10.5.0",
    "esbuild": "^0.28.0",
    "eslint": "^9.37.0",
    "eslint-plugin-vue": "~10.5.0",
    "globals": "^16.4.0",
    "postcss": "^8.5.9",
    "prettier": "3.6.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.8",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "3.2.8"
  },
  "postcss": {
    "plugins": {
      "autoprefixer": {}
    }
  },
  "jshintConfig": {
    "esversion": 6
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 8"
  ]
}
