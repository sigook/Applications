<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<RollForward>Major</RollForward>
		<PackAsTool>true</PackAsTool>
		<ToolCommandName>sigook-mcp</ToolCommandName>
		<PackageId>Sigook.Mcp</PackageId>
		<VersionPrefix>1.0.0</VersionPrefix>
		<Description>MCP server that lets an AI harness operate Sigook through its public API.</Description>
		<InvariantGlobalization>true</InvariantGlobalization>
	</PropertyGroup>

	<ItemGroup>
		<EmbeddedResource Include="Instructions\*.md" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CsvHelper" Version="33.0.1" />
		<PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.13" />
		<PackageReference Include="ModelContextProtocol" Version="2.3.1" />
		<PackageReference Include="PdfPig" Version="0.1.16" />
		<PackageReference Include="Refit.HttpClientFactory" Version="16.4.0" />
		<PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.13" />
	</ItemGroup>

</Project>
