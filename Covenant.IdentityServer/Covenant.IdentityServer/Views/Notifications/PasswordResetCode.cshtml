@model Covenant.IdentityServer.Views.Notifications.PasswordResetCodeViewModel

@{
    ViewBag.Title = "Password Reset Code";
    Layout = "_NotificationsLayout";
}
<table style="background-color: #F5F5F5; padding: 10px 20px 10px; text-align: center;" width="100%">
    <tr>
        <td>
            <div>
                @await Html.PartialAsync("_EnvelopeLogo")
            </div>
        </td>
    </tr>
    <tr>
        <td>
            <h2 style="font-weight: 300;">Hello</h2>
            <div style="font-weight: 200;">
                <p style='margin:0'>You recently requested to reset your password from your Sigook account</p>
                <p style='margin:0'>Use the code below to continue.</p>
            </div>
        </td>
    </tr>
    <tr>
        <td>
            <div style="display: block; border: 2px solid #21b7ff; color: #21b7ff; width: 230px; padding: 10px; margin: 20px auto; background: transparent; font-size: 32px; font-weight: 600; letter-spacing: 8px; font-family: monospace;">
                @Model.Code
            </div>
        </td>
    </tr>
    <tr>
        <td>
            <p style="font-weight: 200; font-size: 12px;">This code expires in @Model.ExpiresMinutes minutes. If you did not request it, you can ignore this email.</p>
        </td>
    </tr>
</table>
