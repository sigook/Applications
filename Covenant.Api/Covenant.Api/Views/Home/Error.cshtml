@model ErrorViewModel
@{
    ViewBag.Title = "Error";
}
<div class="main bg-login">
    <div class="logo"></div>
    <div class="main-container path-login">
        <div class="white-container">
            <div>
                <div class="login-top">
                    @await Html.PartialAsync("_Logo")
                    <h2>Error</h2>
                    <p>Sorry, there was an error@(Model?.Error is null ? "" : $": {Model.Error}")</p>
                    @if (!string.IsNullOrEmpty(Model?.ErrorDescription))
                    {
                        <p>@Model.ErrorDescription</p>
                    }
                </div>
            </div>
        </div>
    </div>
    @await Html.PartialAsync("_LogoBottom")
</div>
