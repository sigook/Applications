@{
    ViewBag.Title = "Invalid User";
}
<div class="main bg-login">
    <div class="logo"></div>
    <div class="main-container path-login">
        <div class="white-container">
            <div>
                <div class="login-top">
                    @await Html.PartialAsync("_Logo")
                    <h2>Invalid User</h2>
                    <p>This account is not allowed to sign in.</p>
                </div>

                <a class="background-btn full-btn orange-button login-button" asp-action="Login" asp-controller="Account">Back to login</a>
            </div>
        </div>
    </div>
    @await Html.PartialAsync("_LogoBottom")
</div>
