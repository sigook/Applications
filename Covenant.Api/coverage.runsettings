<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <CodeCoverage>
            <ModulePaths>
              <Include>
                <ModulePath>.*[\\/]Covenant\.Api\.dll$</ModulePath>
                <ModulePath>.*[\\/]Covenant\.Common\.dll$</ModulePath>
                <ModulePath>.*[\\/]Covenant\.Core\.BL\.dll$</ModulePath>
                <ModulePath>.*[\\/]Covenant\.Documents\.dll$</ModulePath>
                <ModulePath>.*[\\/]Covenant\.Infrastructure\.dll$</ModulePath>
                <ModulePath>.*[\\/]Sigook\.Functions\.dll$</ModulePath>
              </Include>
            </ModulePaths>
            <Sources>
              <Exclude>
                <Source>.*[\\/]Migrations[\\/].*</Source>
                <Source>.*[\\/]obj[\\/].*</Source>
                <Source>.*\.cshtml$</Source>
                <Source>.*\.g\.cs$</Source>
              </Exclude>
            </Sources>
            <Attributes>
              <Exclude>
                <Attribute>^System\.CodeDom\.Compiler\.GeneratedCodeAttribute$</Attribute>
                <Attribute>^System\.Diagnostics\.CodeAnalysis\.ExcludeFromCodeCoverageAttribute$</Attribute>
              </Exclude>
            </Attributes>
          </CodeCoverage>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
