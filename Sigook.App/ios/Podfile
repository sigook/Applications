# Uncomment this line to define a global platform for your project
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      # flutter_additional_ios_build_settings only clears the deployment
      # target on pods that depend on Flutter, so transitive Obj-C pods
      # (SDWebImage, SwiftyGif, DKImagePickerController...) and resource
      # bundles keep their own 9.0/11.0 and trip Xcode's minimum. Pin every
      # target to the same floor as Runner. Keep this in sync with
      # 'platform :ios' above.
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'

      # Suppress all warnings on Pod targets — none of this is our code.
      # Covers: analyzer warnings, deprecation warnings, Swift warnings, compiler warnings.
      config.build_settings['RUN_CLANG_STATIC_ANALYZER'] = 'NO'
      config.build_settings['CLANG_STATIC_ANALYZER_MODE'] = 'shallow'
      config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
      config.build_settings['SWIFT_SUPPRESS_WARNINGS'] = 'YES'
      # -w disables all Clang/GCC compiler warnings (deprecations, type mismatches, etc.)
      config.build_settings['OTHER_CFLAGS'] = ['$(inherited)', '-w']
      config.build_settings['OTHER_CPLUSPLUSFLAGS'] = ['$(inherited)', '-w']

      # CRITICAL: Disable code signing for all Pod targets
      # This prevents "does not support provisioning profiles" errors during CI/CD builds
      # Only the main Runner target should be signed, not the Pods
      config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
      config.build_settings['CODE_SIGNING_REQUIRED'] = 'NO'
      config.build_settings['EXPANDED_CODE_SIGN_IDENTITY'] = ''
      config.build_settings['CODE_SIGN_IDENTITY'] = ''

      # Enable permission_handler permissions for iOS
      # Each permission used by the app must be explicitly enabled here.
      # See: https://pub.dev/packages/permission_handler#setup
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        'PERMISSION_CAMERA=1',
        'PERMISSION_PHOTOS=1',
        'PERMISSION_LOCATION=1',
        'PERMISSION_LOCATION_ALWAYS=1',
      ]
    end
  end
end
