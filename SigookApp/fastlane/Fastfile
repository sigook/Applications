# Fastfile for SigookApp Flutter Build Automation
# Optimized version with corrected paths for Azure DevOps pipeline execution
# This file contains the fastlane lanes for iOS and Android builds
#
# IMPORTANT: Fastlane runs from the 'fastlane/' directory by default.
# All paths use '../' to reference the project root (SigookApp/).

default_platform(:ios)

# ============================================
# iOS Lanes
# ============================================
platform :ios do
  desc "Build and sign iOS app for staging (App Store distribution)"
  lane :beta do |options|
    # NOTE: clear_derived_data is commented out because the pipeline has
    # DerivedData cache disabled. Uncomment if you need fresh builds.
    # clear_derived_data
    
    # Disable automatic signing using xcodeproj gem (more reliable than update_code_signing_settings)
    require 'xcodeproj'
    
    # CORRECTED: Path goes up one level from fastlane/ to SigookApp/
    project_path = '../ios/Runner.xcodeproj'
    project = Xcodeproj::Project.open(project_path)
    
    project.targets.each do |target|
      if target.name == 'Runner'
        target.build_configurations.each do |config|
          UI.message("Configuring #{config.name} for manual signing...")
          config.build_settings['CODE_SIGN_STYLE'] = 'Manual'
          config.build_settings['DEVELOPMENT_TEAM'] = 'NGXFWU4H7Z'
          config.build_settings['CODE_SIGN_IDENTITY'] = 'Apple Distribution'
          config.build_settings['CODE_SIGN_IDENTITY[sdk=iphoneos*]'] = 'Apple Distribution'
          config.build_settings['PROVISIONING_PROFILE_SPECIFIER'] = 'sigookbeta'
        end
      end
    end
    
    project.save
    UI.success("✅ Manual signing configured for Runner target")
    
    # Archive the app
    # CORRECTED: All paths use '../' to reference project root
    gym(
      workspace: "../ios/Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      export_team_id: "NGXFWU4H7Z",
      codesigning_identity: "Apple Distribution: SIGOOK CORPORATION (NGXFWU4H7Z)",
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        compileBitcode: false,
        destination: "export",
        teamID: "NGXFWU4H7Z"
      },
      output_directory: "../output",
      output_name: "SigookApp.ipa",
      clean: true,
      skip_build_archive: false,
      archive_path: "../build/ios/Runner.xcarchive",
      export_xcargs: "-allowProvisioningUpdates",
      xcargs: "DEVELOPMENT_TEAM=NGXFWU4H7Z CODE_SIGN_IDENTITY='Apple Distribution: SIGOOK CORPORATION (NGXFWU4H7Z)'",
      silent: false,
      verbose: true
    )
    
    UI.success("✅ iOS IPA built and signed successfully!")
    UI.message("IPA location: ../output/SigookApp.ipa")
  end

  desc "Run iOS tests"
  lane :test do
    run_tests(
      workspace: "../ios/Runner.xcworkspace",
      scheme: "Runner",
      device: "iPhone 14"
    )
  end
  
  desc "Clean build artifacts"
  lane :clean do
    clear_derived_data
    # This command already uses 'cd ..' so it's correct
    sh("cd .. && rm -rf output build ios/Pods")
    UI.success("✅ Cleaned all build artifacts")
  end
end

# ============================================
# Android Lanes
# ============================================
platform :android do
  desc "Build and sign Android app bundle for staging"
  lane :beta do |options|
    # CORRECTED: Path goes up one level from fastlane/ to SigookApp/
    gradle(
      project_dir: "../android",
      task: "bundle",
      flavor: "staging",
      build_type: "Release",
      print_command: true,
      properties: {
        "android.injected.signing.store.file" => ENV["KEYSTORE_FILE"],
        "android.injected.signing.store.password" => ENV["KEY_PASSWORD"],
        "android.injected.signing.key.alias" => ENV["KEY_ALIAS"],
        "android.injected.signing.key.password" => ENV["KEY_PASSWORD"]
      }
    )
    
    UI.success("✅ Android AAB built and signed successfully!")
  end

  desc "Build APK for local testing"
  lane :apk do
    # CORRECTED: Path goes up one level from fastlane/ to SigookApp/
    gradle(
      project_dir: "../android",
      task: "assemble",
      flavor: "staging",
      build_type: "Release"
    )
  end

  desc "Run Android tests"
  lane :test do
    # CORRECTED: Path goes up one level from fastlane/ to SigookApp/
    gradle(
      project_dir: "../android",
      task: "test",
      flavor: "staging",
      build_type: "Debug"
    )
  end
  
  desc "Clean Android build artifacts"
  lane :clean do
    # CORRECTED: Path goes up one level from fastlane/ to SigookApp/
    gradle(
      project_dir: "../android",
      task: "clean"
    )
    UI.success("✅ Cleaned Android build artifacts")
  end
end

# ============================================
# Shared Lanes
# ============================================

desc "Display environment information"
lane :info do
  UI.header("Environment Information")
  UI.message("Fastlane version: #{Fastlane::VERSION}")
  UI.message("Ruby version: #{RUBY_VERSION}")
  UI.message("Working directory: #{Dir.pwd}")
  
  # Show the actual paths being used
  UI.message("iOS project path: #{File.expand_path('../ios/Runner.xcodeproj', Dir.pwd)}")
  UI.message("Android project path: #{File.expand_path('../android', Dir.pwd)}")
  
  if is_ci
    UI.message("Running in CI environment")
    UI.message("CI Platform: #{ENV['CI'] || 'Unknown'}")
  else
    UI.message("Running locally")
  end
end

# Error handling
error do |lane, exception|
  UI.error("Error in lane '#{lane}':")
  UI.error(exception.message)
  UI.error(exception.backtrace.join("\n")) if exception.backtrace
end
