# Fastfile for SigookApp Flutter Build Automation
# Optimized version with corrected paths for Azure DevOps pipeline execution
# This file contains the fastlane lanes for iOS and Android builds
#
# IMPORTANT PATH HANDLING:
# - Fastlane automatically changes directory to 'fastlane/' when executing
# - Ruby code (Xcodeproj) respects this chdir and resolves '../' correctly
# - Fastlane actions (gym, gradle) resolve relative paths from the ORIGINAL CWD (where fastlane was called)
# - SOLUTION: Use File.expand_path("../path", __dir__) to convert to absolute paths
#   - __dir__ = directory of this Fastfile (SigookApp/fastlane/)
#   - "../ios/Runner.xcworkspace" relative to __dir__ = SigookApp/ios/Runner.xcworkspace
#   - File.expand_path converts this to an absolute path that works everywhere

default_platform(:ios)

# ============================================
# iOS Lanes
# ============================================
platform :ios do
  desc "Build and sign iOS app for staging (App Store distribution)"
  lane :beta do |options|
    # NOTE: clear_derived_data is commented out because the pipeline has
    # DerivedData cache disabled. Uncomment if you need fresh builds.
    # clear_derived_data
    
    # Configure manual code signing
    # Find the installed provisioning profile
    profile_path = Dir.glob(File.expand_path("~/Library/MobileDevice/Provisioning Profiles/*.mobileprovision")).first

    if profile_path.nil?
      UI.user_error!("❌ No provisioning profile found in ~/Library/MobileDevice/Provisioning Profiles/")
    end

    # Extract UUID from the provisioning profile
    profile_content = `security cms -D -i "#{profile_path}"`
    profile_uuid = profile_content.match(/<key>UUID<\/key>\s*<string>([^<]+)<\/string>/)[1]
    profile_name = profile_content.match(/<key>Name<\/key>\s*<string>([^<]+)<\/string>/)[1]

    UI.message("📝 Found provisioning profile:")
    UI.message("   Name: #{profile_name}")
    UI.message("   UUID: #{profile_uuid}")
    UI.message("   Path: #{profile_path}")

    # Configure Xcode project with manual signing
    require 'xcodeproj'
    project_path = '../ios/Runner.xcodeproj'
    project = Xcodeproj::Project.open(project_path)

    project.targets.each do |target|
      if target.name == 'Runner'
        target.build_configurations.each do |config|
          UI.message("Configuring #{config.name} for manual signing...")
          config.build_settings['CODE_SIGN_STYLE'] = 'Manual'
          config.build_settings['DEVELOPMENT_TEAM'] = 'NGXFWU4H7Z'
          config.build_settings['CODE_SIGN_IDENTITY'] = 'Apple Distribution'
          config.build_settings['CODE_SIGN_IDENTITY[sdk=iphoneos*]'] = 'Apple Distribution'
          # Use the UUID of the provisioning profile
          config.build_settings['PROVISIONING_PROFILE_SPECIFIER'] = profile_uuid
        end
      end
    end

    project.save
    UI.success("✅ Manual signing configured for Runner target")
    
    # Use xcodebuild directly for better control over the archive/export process
    # Flutter already built the app with --no-codesign, we just need to archive and sign
    workspace_path = File.expand_path("../ios/Runner.xcworkspace", __dir__)
    output_path = File.expand_path("../output", __dir__)
    archive_path = File.expand_path("../build/ios/Runner.xcarchive", __dir__)
    export_options_path = File.expand_path("../ios/ExportOptions-staging.plist", __dir__)

    UI.message("📁 Workspace: #{workspace_path}")
    UI.message("📁 Output: #{output_path}")
    UI.message("📁 Archive: #{archive_path}")
    UI.message("📁 ExportOptions: #{export_options_path}")

    # Create output directory
    FileUtils.mkdir_p(output_path)

    # Update ExportOptions.plist with the correct provisioning profile name
    require 'plist'
    export_options_content = {
      "method" => "app-store",
      "teamID" => "NGXFWU4H7Z",
      "signingStyle" => "manual",
      "signingCertificate" => "Apple Distribution: SIGOOK CORPORATION (NGXFWU4H7Z)",
      "provisioningProfiles" => {
        "com.sigook.beta" => profile_name
      },
      "compileBitcode" => false,
      "uploadSymbols" => true
    }

    temp_export_options = File.expand_path("../build/ios/ExportOptions.plist", __dir__)
    File.write(temp_export_options, export_options_content.to_plist)
    UI.message("📝 Created ExportOptions.plist with profile: #{profile_name}")

    # Step 1: Create archive manually from Flutter's pre-built .app
    # Flutter built the app with --no-codesign, creating build/ios/iphoneos/Runner.app
    # We'll manually create an xcarchive structure and sign it
    UI.header("Step 1: Creating Archive from Pre-built App")

    app_path = File.expand_path("../build/ios/iphoneos/Runner.app", __dir__)

    unless File.exist?(app_path)
      UI.user_error!("❌ Pre-built app not found at #{app_path}. Run 'flutter build ios --no-codesign' first.")
    end

    UI.message("📱 Found pre-built app: #{app_path}")

    # Create xcarchive structure manually
    # Structure: Runner.xcarchive/Products/Applications/Runner.app
    FileUtils.rm_rf(archive_path) if File.exist?(archive_path)
    archive_apps_path = "#{archive_path}/Products/Applications"
    FileUtils.mkdir_p(archive_apps_path)

    # Copy the app to the archive
    FileUtils.cp_r(app_path, archive_apps_path)
    UI.message("📁 Copied app to archive structure")

    # Sign the app with codesign
    UI.header("Signing the App")
    app_in_archive = "#{archive_apps_path}/Runner.app"
    signing_identity = "Apple Distribution: SIGOOK CORPORATION (NGXFWU4H7Z)"

    # Extract entitlements from the provisioning profile FIRST (needed for signing)
    entitlements_path = File.expand_path("../build/ios/entitlements.plist", __dir__)
    sh("security cms -D -i '#{profile_path}' > /tmp/profile.plist")
    sh("/usr/libexec/PlistBuddy -x -c 'Print :Entitlements' /tmp/profile.plist > '#{entitlements_path}'")
    UI.message("📝 Extracted entitlements from provisioning profile")

    # Sign all frameworks and dylibs inside the app
    # This must be done before signing the main app bundle
    frameworks_path = "#{app_in_archive}/Frameworks"

    if File.exist?(frameworks_path)
      # Sign all frameworks
      Dir.glob("#{frameworks_path}/*.framework").each do |framework|
        UI.message("Signing framework: #{File.basename(framework)}")
        # Sign nested frameworks/dylibs first if they exist
        nested_frameworks = Dir.glob("#{framework}/Frameworks/*.framework")
        nested_frameworks.each do |nested|
          sh("codesign --force --sign '#{signing_identity}' --timestamp '#{nested}'")
        end
        sh("codesign --force --sign '#{signing_identity}' --timestamp '#{framework}'")
      end

      # Sign all dylibs
      Dir.glob("#{frameworks_path}/*.dylib").each do |dylib|
        UI.message("Signing dylib: #{File.basename(dylib)}")
        sh("codesign --force --sign '#{signing_identity}' --timestamp '#{dylib}'")
      end
    end

    # Sign any app extensions (they need entitlements)
    plugins_path = "#{app_in_archive}/PlugIns"
    if File.exist?(plugins_path)
      Dir.glob("#{plugins_path}/*.appex").each do |appex|
        UI.message("Signing app extension: #{File.basename(appex)}")
        sh("codesign --force --sign '#{signing_identity}' --entitlements '#{entitlements_path}' --timestamp '#{appex}'")
      end
    end

    # Sign the main app bundle (must be done LAST, after all nested components)
    UI.message("Signing main app bundle...")
    sh("codesign --force --sign '#{signing_identity}' --entitlements '#{entitlements_path}' --timestamp '#{app_in_archive}'")

    # Create Info.plist for the archive
    app_info_plist = "#{app_in_archive}/Info.plist"
    app_bundle_id = `/usr/libexec/PlistBuddy -c "Print :CFBundleIdentifier" "#{app_info_plist}"`.strip
    app_version = `/usr/libexec/PlistBuddy -c "Print :CFBundleShortVersionString" "#{app_info_plist}"`.strip
    app_build = `/usr/libexec/PlistBuddy -c "Print :CFBundleVersion" "#{app_info_plist}"`.strip
    app_name = `/usr/libexec/PlistBuddy -c "Print :CFBundleName" "#{app_info_plist}"`.strip rescue "Runner"

    archive_info = {
      "ApplicationProperties" => {
        "ApplicationPath" => "Applications/Runner.app",
        "Architectures" => ["arm64"],
        "CFBundleIdentifier" => app_bundle_id,
        "CFBundleShortVersionString" => app_version,
        "CFBundleVersion" => app_build,
        "SigningIdentity" => signing_identity,
        "Team" => "NGXFWU4H7Z"
      },
      "ArchiveVersion" => 2,
      "CreationDate" => Time.now,
      "Name" => app_name,
      "SchemeName" => "Runner"
    }

    File.write("#{archive_path}/Info.plist", archive_info.to_plist)
    UI.success("✅ Archive created and signed successfully")

    # Step 2: Export the archive to IPA
    UI.header("Step 2: Exporting IPA")
    export_cmd = [
      "xcodebuild",
      "-exportArchive",
      "-archivePath", archive_path,
      "-exportPath", output_path,
      "-exportOptionsPlist", temp_export_options,
      "-allowProvisioningUpdates"
    ].join(" ")

    UI.command(export_cmd)
    sh(export_cmd)

    # Find and rename the IPA
    ipa_files = Dir.glob("#{output_path}/*.ipa")
    if ipa_files.empty?
      UI.user_error!("❌ No IPA file found in #{output_path}")
    end

    # Rename to SigookApp.ipa if needed
    original_ipa = ipa_files.first
    final_ipa = "#{output_path}/SigookApp.ipa"
    if original_ipa != final_ipa
      FileUtils.mv(original_ipa, final_ipa)
    end

    UI.success("✅ iOS IPA built and signed successfully!")
    UI.message("IPA location: #{output_path}/SigookApp.ipa")
  end

  desc "Run iOS tests"
  lane :test do
    workspace_path = File.expand_path("../ios/Runner.xcworkspace", __dir__)
    run_tests(
      workspace: workspace_path,
      scheme: "Runner",
      device: "iPhone 14"
    )
  end

  desc "Deploy to TestFlight"
  lane :deploy do |options|
    # Get the IPA path
    ipa_path = options[:ipa] || File.expand_path("../output/SigookApp.ipa", __dir__)
    
    unless File.exist?(ipa_path)
      UI.user_error!("❌ IPA not found at #{ipa_path}")
    end
    
    UI.message("📤 Uploading to TestFlight: #{ipa_path}")
    
    # Upload to TestFlight using App Store Connect API
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: true,
      in_house: false
    )
    
    upload_to_testflight(
      ipa: ipa_path,
      skip_waiting_for_build_processing: true,
      skip_submission: true,
      notify_external_testers: false
    )
    
    UI.success("✅ Successfully uploaded to TestFlight!")
  end

  desc "Clean build artifacts"
  lane :clean do
    clear_derived_data
    # Fastlane runs from fastlane/ directory
    sh("cd .. && rm -rf output build ios/Pods")
    UI.success("✅ Cleaned all build artifacts")
  end
end

# ============================================
# Android Lanes
# ============================================
platform :android do
  desc "Build and sign Android app bundle for staging"
  lane :beta do |options|
    # Use absolute path for gradle to avoid path resolution issues
    android_path = File.expand_path("../android", __dir__)
    gradle(
      project_dir: android_path,
      task: "bundle",
      flavor: "staging",
      build_type: "Release",
      print_command: true,
      properties: {
        "android.injected.signing.store.file" => ENV["KEYSTORE_FILE"],
        "android.injected.signing.store.password" => ENV["KEY_PASSWORD"],
        "android.injected.signing.key.alias" => ENV["KEY_ALIAS"],
        "android.injected.signing.key.password" => ENV["KEY_PASSWORD"]
      }
    )

    UI.success("✅ Android AAB built and signed successfully!")
  end

  desc "Build APK for local testing"
  lane :apk do
    # Use absolute path for gradle to avoid path resolution issues
    android_path = File.expand_path("../android", __dir__)
    gradle(
      project_dir: android_path,
      task: "assemble",
      flavor: "staging",
      build_type: "Release"
    )
  end

  desc "Run Android tests"
  lane :test do
    # Use absolute path for gradle to avoid path resolution issues
    android_path = File.expand_path("../android", __dir__)
    gradle(
      project_dir: android_path,
      task: "test",
      flavor: "staging",
      build_type: "Debug"
    )
  end

  desc "Deploy to Google Play Store (Internal Testing)"
  lane :deploy do |options|
    # Find the AAB file
    aab_path = options[:aab] || Dir.glob(File.expand_path("../build/app/outputs/bundle/stagingRelease/*.aab", __dir__)).first

    if aab_path.nil? || !File.exist?(aab_path)
      UI.user_error!("❌ AAB not found. Build the app first with 'fastlane android beta'")
    end

    UI.message("📤 Uploading to Google Play: #{aab_path}")

    # Get and decode the Google Play JSON key (base64 encoded in Azure DevOps)
    json_key_raw = ENV["GOOGLE_PLAY_JSON_KEY"]
    if json_key_raw.nil? || json_key_raw.empty?
      UI.user_error!("❌ GOOGLE_PLAY_JSON_KEY environment variable is not set")
    end

    # Decode base64 if the key appears to be encoded (doesn't start with '{')
    json_key_data = if json_key_raw.strip.start_with?('{')
      json_key_raw
    else
      require 'base64'
      Base64.decode64(json_key_raw)
    end

    # Upload to Google Play Internal Testing track
    upload_to_play_store(
      track: "internal",
      aab: aab_path,
      json_key_data: json_key_data,
      package_name: "com.sigook.beta",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
    
    UI.success("✅ Successfully uploaded to Google Play Internal Testing!")
  end

  desc "Clean Android build artifacts"
  lane :clean do
    # Use absolute path for gradle to avoid path resolution issues
    android_path = File.expand_path("../android", __dir__)
    gradle(
      project_dir: android_path,
      task: "clean"
    )
    UI.success("✅ Cleaned Android build artifacts")
  end
end

# ============================================
# Shared Lanes
# ============================================

desc "Display environment information"
lane :info do
  UI.header("Environment Information")
  UI.message("Fastlane version: #{Fastlane::VERSION}")
  UI.message("Ruby version: #{RUBY_VERSION}")
  UI.message("Working directory: #{Dir.pwd}")

  # Show the actual paths being used (fastlane runs from fastlane/ directory)
  UI.message("iOS project path: #{File.expand_path('../ios/Runner.xcodeproj', Dir.pwd)}")
  UI.message("Android project path: #{File.expand_path('../android', Dir.pwd)}")

  if is_ci
    UI.message("Running in CI environment")
    UI.message("CI Platform: #{ENV['CI'] || 'Unknown'}")
  else
    UI.message("Running locally")
  end
end

# Error handling
error do |lane, exception|
  UI.error("Error in lane '#{lane}':")
  UI.error(exception.message)
  UI.error(exception.backtrace.join("\n")) if exception.backtrace
end
