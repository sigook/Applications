# Environment Configuration Example
# ==================================
# Copy this file to create your environment-specific config:
#
#   cp .env.example .env.local      # For local development (localhost services)
#   cp .env.example .env.staging    # For staging environment
#   cp .env.example .env.production # For production environment
#
# These files are in .gitignore and won't be committed to version control.
#
# CI/CD (Azure DevOps):
#   The pipeline generates the .env file from Azure DevOps Variable Groups
#   before building. The app always reads from .env files.
#
# Run commands:
#   flutter run --flavor staging -t lib/main_local.dart      # Local services
#   flutter run --flavor staging -t lib/main_staging.dart    # Staging servers
#   flutter run --flavor production -t lib/main_production.dart  # Production

# ============================================================================
# CONFIGURATION VALUES
# ============================================================================

# Environment name: local, staging, or production
ENVIRONMENT=staging

# IdentityServer URL (OAuth authority)
# Local:      https://10.0.2.2:44381/        (Android emulator to localhost)
# Local:      https://localhost:44381/       (iOS simulator)
# Staging:    https://staging.accounts.sigook.ca/
# Production: https://accounts.sigook.ca/
AUTH_AUTHORITY=https://staging.accounts.sigook.ca/

# OAuth Client ID (must match IdentityServer client configuration)
# Android: android
# iOS: ios
CLIENT_ID=android

# OAuth Redirect URIs (MUST match IdentityServer client configuration!)
# IdentityServer Android client accepts: com.sigook:/oauth2redirect
# IdentityServer iOS client accepts: com.all2job:/oauth2redirect
#
# Android builds use: com.sigook:/oauth2redirect
# iOS builds use: com.all2job:/oauth2redirect (injected via pipeline)
REDIRECT_URI=com.sigook:/oauth2redirect
POST_LOGOUT_REDIRECT_URI=com.sigook:/oauth2logout

# API Base URL
# Local:      https://10.0.2.2:44307/api/    (Android emulator to localhost)
# Local:      https://localhost:44307/api/   (iOS simulator)
# Staging:    https://staging.api.sigook.ca/api/
# Production: https://api.sigook.ca/api
API_BASE_URL=https://staging.api.sigook.ca/api/

# OAuth Scopes (comma-separated, NO SPACES)
SCOPES=openid,profile,api1,offline_access

# App Display Name
APP_NAME=SIGOOK Beta

# ============================================================================
# PLATFORM-SPECIFIC OAUTH NOTES
# ============================================================================
# The IdentityServer has separate clients for Android and iOS:
#
# ANDROID CLIENT (ClientId: "android"):
#   RedirectUri: com.sigook:/oauth2redirect
#   PostLogoutRedirectUri: com.sigook:/oauth2logout
#
# iOS CLIENT (ClientId: "ios"):
#   RedirectUri: com.all2job:/oauth2redirect
#   PostLogoutRedirectUri: com.all2job:/oauth2logout
#
# The CI/CD pipeline generates the .env file with the correct values for each platform:
# - Android builds: Uses CLIENT_ID=android, REDIRECT_URI=com.sigook:/oauth2redirect
# - iOS builds: Uses CLIENT_ID=ios, REDIRECT_URI=com.all2job:/oauth2redirect

# ============================================================================
# LOCAL DEVELOPMENT NOTES
# ============================================================================
# For mobile devices/emulators to connect to localhost:
#
# Android Emulator:
#   - Use 10.0.2.2 instead of localhost (special alias to host machine)
#   - Example: https://10.0.2.2:44381/
#
# iOS Simulator:
#   - Can use localhost directly
#   - Example: https://localhost:44381/
#
# Physical Device:
#   - Use your machine's local IP address
#   - Find IP: ipconfig (Windows) or ifconfig (Mac/Linux)
#   - Example: https://192.168.1.100:44381/
#
# SSL Certificate Issues:
#   - Local HTTPS may have self-signed certificates
#   - For development, you may need to accept untrusted certs in the app
#   - Or install the dev certificate on your device/emulator
