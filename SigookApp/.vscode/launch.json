{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Staging",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_staging.dart",
      "toolArgs": [
        "--dart-define-from-file=.env.staging"
      ],
      "args": [
        "--flavor",
        "staging"
      ]
    },
    {
      "name": "Production",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_production.dart",
      "toolArgs": [
        "--dart-define-from-file=.env.production"
      ],
      "args": [
        "--flavor",
        "production"
      ]
    },
    {
      "name": "Local (localhost services)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_local.dart",
      "toolArgs": [
        "--dart-define-from-file=.env.local"
      ],
      "args": [
        "--flavor",
        "production"
      ]
    },
    {
      "name": "Attach to Flutter Process",
      "request": "attach",
      "type": "dart"
    }
  ]
}
